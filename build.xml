<?xml version="1.0"?><!-- Brno University of TechnologyFaculty of Information Technology BSc Thesis	2006/2007 Railway Interlocking Simulatorant build - kompilaceant start - spusteniant doc - vygenerovani programove dokumentace ze zdrojoveho koduHovorka Bedrich <xhovor07@stud.fit.vutbr.cz>--><!DOCTYPE project><project basedir="." default="build" name="interlockSim">    <path id="project.classpath">        <pathelement location="build"/>    </path>    <target name="init">        <mkdir dir="build"/>    </target>    <target name="clean">        <delete dir="build"/>        <delete dir="jar"/>    </target>    <target depends="init" name="build">        <echo message="${ant.project.name}: ${ant.file}"/>        <javac destdir="build">            <src path="src"/>            <classpath refid="project.classpath"/>        </javac>
    	<copy todir="build/cz/vutbr/fit/interlockSim/resource">
    	 <fileset dir="src/cz/vutbr/fit/interlockSim/resource" />
    	</copy>    </target>    <target depends="build" name="start"><!-- spusteni bez jar -->        <java jvmargs="-ea" classname="cz.vutbr.fit.interlockSim.Main" args="example shuntingLoop 60" failonerror="true" fork="yes">            <classpath refid="project.classpath"/>        </java>    </target>    <target depends="build" name="pack">	<mkdir dir="jar"/>        <jar destfile="jar/interlockSim.jar" basedir="build">          <manifest>		<attribute name="Main-Class" value="cz.vutbr.fit.interlockSim.Main"/>          </manifest>        </jar>    </target>    <target depends="pack" name="run"><!-- spusteni z jar -->        <java jar="jar/interlockSim.jar" args="edit" failonerror="true" fork="yes">          <classpath>           <pathelement location="jar"/>           <pathelement path="${java.class.path}"/>          </classpath>        </java>    </target>    <target depends="init" name="doc">	    <mkdir dir="doc"/>	    <javadoc packagenames="cz.vutbr.fit.interlockSim.*,jDisco.*" destdir="doc" sourcepath="src" 		     windowtitle="InterlockSim Packages and Classes">		    <doctitle><![CDATA[jDisco &amp; InterlockSim Generated Documentation]]></doctitle>		    <bottom>          <![CDATA[            jDisco &#169; 2001 - 2004 Keld Helsgaun - keld@ruc.dk <br>            interlockSim &#169; 2006 - 2007 Bedrich Hovorka - xhovor07@stud.fit.vutbr.cz          ]]>        </bottom>		    <link href="http://java.sun.com/javase/6/docs/api/" />            </javadoc>    </target></project>