<?xml version="1.0"?>
<!--
Brno University of Technology
Faculty of Information Technology

BSc Thesis	2006/2007
Railway Interlocking Simulator

Build targets:
  ant resolve       - Download dependencies via Ivy
  ant build         - Compile main code, tests, and run tests
  ant test          - Run tests only
  ant start         - Run simulation example
  ant run           - Run GUI editor
  ant pack          - Create uber JAR
  ant doc           - Generate JavaDoc documentation
  ant clean         - Remove build artifacts
  ant clean-all     - Clean everything including Ivy cache

Hovorka Bedrich <xhovor07@stud.fit.vutbr.cz>
Ivy integration: 2025
-->
<!DOCTYPE project>
<project basedir="." default="build" name="interlockSim" xmlns:ivy="antlib:org.apache.ivy.ant">

    <!-- ============================================ -->
    <!-- Properties                                    -->
    <!-- ============================================ -->

    <!-- Source directories -->
    <property name="src.main.java" location="src/main/java"/>
    <property name="src.test.java" location="src/test/java"/>
    <property name="src.main.resources" location="src/main/resources"/>

    <!-- Build directories -->
    <property name="build.main" location="build/main"/>
    <property name="build.test" location="build/test"/>

    <!-- Dependency directories -->
    <property name="lib.dir" location="lib"/>
    <property name="lib.compile" location="${lib.dir}/compile"/>
    <property name="lib.test" location="${lib.dir}/test"/>

    <!-- Output directories -->
    <property name="jar.dir" location="jar"/>
    <property name="doc.dir" location="doc"/>

    <!-- Ivy configuration -->
    <property name="ivy.install.version" value="2.5.2"/>
    <property name="ivy.jar.dir" location="${basedir}/.ivy2"/>
    <property name="ivy.jar.file" location="${ivy.jar.dir}/ivy-${ivy.install.version}.jar"/>

    <!-- Maven local repository for jDisco -->
    <property name="maven.local.repo" location="${user.home}/.m2/repository"/>
    <property name="jdisco.jar" location="${maven.local.repo}/dk/ruc/keld/jdisco/1.2.0/jdisco-1.2.0.jar"/>

    <!-- ============================================ -->
    <!-- Ivy Bootstrap                                 -->
    <!-- ============================================ -->

    <target name="download-ivy" unless="skip.download">
        <mkdir dir="${ivy.jar.dir}"/>
        <echo message="Downloading Ivy ${ivy.install.version}..."/>
        <get src="https://repo1.maven.org/maven2/org/apache/ivy/ivy/${ivy.install.version}/ivy-${ivy.install.version}.jar"
             dest="${ivy.jar.file}"
             usetimestamp="true"/>
    </target>

    <target name="install-ivy" depends="download-ivy">
        <path id="ivy.lib.path">
            <fileset dir="${ivy.jar.dir}" includes="*.jar"/>
        </path>
        <taskdef resource="org/apache/ivy/ant/antlib.xml"
                 uri="antlib:org.apache.ivy.ant"
                 classpathref="ivy.lib.path"/>
    </target>

    <!-- ============================================ -->
    <!-- Dependency Management                         -->
    <!-- ============================================ -->

    <target name="resolve" depends="install-ivy,check-jdisco"
            description="Retrieve dependencies with Ivy">
        <ivy:retrieve pattern="${lib.dir}/[conf]/[artifact]-[revision].[ext]"
                      conf="compile,test"/>
    </target>

    <!-- ============================================ -->
    <!-- Classpath Definitions                         -->
    <!-- ============================================ -->

    <path id="compile.classpath">
        <fileset dir="${lib.compile}">
            <include name="*.jar"/>
        </fileset>
    </path>

    <path id="test.classpath">
        <path refid="compile.classpath"/>
        <pathelement location="${build.main}"/>
        <fileset dir="${lib.test}">
            <include name="*.jar"/>
        </fileset>
    </path>

    <path id="runtime.classpath">
        <path refid="compile.classpath"/>
        <pathelement location="${build.main}"/>
    </path>

    <!-- ============================================ -->
    <!-- Dependency Verification                       -->
    <!-- ============================================ -->

    <target name="check-jdisco">
        <available file="${jdisco.jar}" property="jdisco.present"/>
        <fail unless="jdisco.present">
jDisco library not found at ${jdisco.jar}
Please build and install jDisco first:
  cd jdisco &amp;&amp; mvn install
Or use Docker:
  cd jdisco &amp;&amp; docker compose run jdisco mvn install
        </fail>
    </target>

    <!-- ============================================ -->
    <!-- Build Targets                                 -->
    <!-- ============================================ -->

    <target name="init">
        <mkdir dir="${build.main}"/>
        <mkdir dir="${build.test}"/>
    </target>

    <target name="clean" description="Remove build artifacts">
        <delete dir="build"/>
        <delete dir="${jar.dir}"/>
        <delete dir="${lib.dir}"/>
    </target>

    <target name="clean-all" depends="clean" description="Clean everything including Ivy cache">
        <delete dir="${ivy.jar.dir}"/>
    </target>

    <target name="compile-main" depends="init,resolve" description="Compile main code">
        <echo message="Compiling main code..."/>
        <javac srcdir="${src.main.java}"
               destdir="${build.main}"
               source="1.6"
               target="1.6"
               encoding="ISO-8859-1"
               includeantruntime="false"
               debug="true">
            <classpath refid="compile.classpath"/>
        </javac>

        <!-- Copy resources to build directory -->
        <copy todir="${build.main}">
            <fileset dir="${src.main.resources}"/>
        </copy>
    </target>

    <target name="compile-test" depends="compile-main" description="Compile test code">
        <echo message="Compiling test code..."/>
        <javac srcdir="${src.test.java}"
               destdir="${build.test}"
               source="1.6"
               target="1.6"
               encoding="ISO-8859-1"
               includeantruntime="false"
               debug="true">
            <classpath refid="test.classpath"/>
        </javac>
    </target>

    <target name="test" depends="compile-test" description="Run tests">
        <echo message="Running tests..."/>
        <junit printsummary="yes"
               haltonfailure="yes"
               haltonerror="yes"
               fork="yes">
            <classpath>
                <path refid="test.classpath"/>
                <pathelement location="${build.test}"/>
            </classpath>

            <formatter type="plain" usefile="false"/>

            <batchtest>
                <fileset dir="${src.test.java}">
                    <include name="**/*Test.java"/>
                </fileset>
            </batchtest>
        </junit>
    </target>

    <target name="build" depends="compile-main,compile-test,test"
            description="Build and test the project">
        <echo message="${ant.project.name}: Build completed successfully"/>
    </target>

    <!-- ============================================ -->
    <!-- Execution Targets                             -->
    <!-- ============================================ -->

    <target name="start" depends="build" description="Run simulation example">
        <java classname="cz.vutbr.fit.interlockSim.Main"
              args="example shuntingLoop 60"
              failonerror="true"
              fork="yes">
            <jvmarg value="-ea"/>
            <classpath refid="runtime.classpath"/>
        </java>
    </target>

    <target name="pack" depends="build" description="Create uber JAR">
        <mkdir dir="${jar.dir}"/>
        <echo message="Creating uber JAR with all dependencies..."/>

        <jar destfile="${jar.dir}/interlockSim.jar">
            <manifest>
                <attribute name="Main-Class" value="cz.vutbr.fit.interlockSim.Main"/>
            </manifest>

            <!-- Include interlockSim classes -->
            <fileset dir="${build.main}"/>

            <!-- Extract and include jDisco classes -->
            <zipfileset src="${lib.compile}/jdisco-1.2.0.jar"
                        excludes="META-INF/*.SF,META-INF/*.DSA,META-INF/*.RSA"/>
        </jar>
    </target>

    <target name="run" depends="pack" description="Run GUI editor from JAR">
        <java jar="${jar.dir}/interlockSim.jar"
              args="edit"
              failonerror="true"
              fork="yes">
            <jvmarg value="-ea"/>
        </java>
    </target>

    <!-- ============================================ -->
    <!-- Documentation                                 -->
    <!-- ============================================ -->

    <target name="doc" depends="init,resolve" description="Generate JavaDoc">
        <mkdir dir="${doc.dir}"/>
        <javadoc packagenames="cz.vutbr.fit.interlockSim.*"
                 destdir="${doc.dir}"
                 sourcepath="${src.main.java}"
                 windowtitle="InterlockSim Packages and Classes">
            <classpath refid="compile.classpath"/>
            <doctitle><![CDATA[InterlockSim Generated Documentation]]></doctitle>
            <bottom>
                <![CDATA[
                    interlockSim &#169; 2006 - 2007 Bedrich Hovorka - xhovor07@stud.fit.vutbr.cz<br>
                    jDisco &#169; 2001 - 2004 Keld Helsgaun - keld@ruc.dk
                ]]>
            </bottom>
            <link href="http://java.sun.com/javase/6/docs/api/"/>
        </javadoc>
    </target>

</project>
