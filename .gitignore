# Runtime log directory. The whole directory, not just *.log: logback's appender is
# append-mode with no rotation, so rotated copies (interlockSim.log.2026-08-06) sit here too
# and match neither /logs/interlockSim.log nor *.log.
/logs/
*.log

# Phase 0: Baseline outputs (regenerate with ./capture-golden-outputs.sh)
# Only track metadata (README, analysis, checksums), not 22MB of .log files

# Claude Code -- ignore local/personal files; commit settings.json and hooks/
.claude/*
!.claude/settings.json
!.claude/hooks/
desktop-ui/*.xml

# Pre-built kDisco artifacts for Docker — now fetched from GitHub Packages
/docker-kdisco/

# Claude Code superpowers workspace files (local-only)
/.superpowers/
