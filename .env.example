# GitHub Packages Authentication
# Copy this file to .env and fill in your credentials
# Required for downloading the kDisco dependency from GitHub Packages
#
# IMPORTANT: docker compose auto-loads .env only for ${VAR} interpolation. The
# BuildKit secrets used for the build (secrets.environment in docker-compose.yml)
# read the value from the *process* environment, so you must EXPORT these vars
# before building, not just define them here:
#
#     set -a; source .env; set +a
#     docker compose up --build
#
# (set -a marks subsequent assignments for export; set +a turns it back off.)

# Your GitHub username
GITHUB_ACTOR=your-github-username

# Your GitHub Personal Access Token with 'read:packages' scope
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your-personal-access-token

# Note: GitHub Packages requires authentication even for public packages
# See: https://docs.github.com/en/packages/working-with-a-github-packages-registry/working-with-the-gradle-registry

# --- Docker Compose runtime settings (read by docker-compose.yml via ${VAR} interpolation) ---

# Host user's UID/GID, so the app container can read the 0600 X11 auth cookie and write
# artifacts with host-user ownership. Defaults to 1000/1000; uncomment and set to the
# output of `id -u` / `id -g`. Left commented on purpose: `set -a; source .env; set +a`
# would otherwise override an earlier `export RUNTIME_UID=$(id -u)`.
# RUNTIME_UID=1000
# RUNTIME_GID=1000

# Compose 2.20+ is required: the `app` service uses `depends_on ... required: false`, and older
# Compose rejects the whole file.
#
# Ollama endpoint for the LLM dispatcher in the `app` service (a plain environment
# variable; there is no -D property). The app runs with network_mode: host, so on Linux the
# default reaches both the compose `ollama` service and a native `ollama serve`.
# Commented out because sourcing .env exports every variable into host Gradle runs too.
# OLLAMA_BASE_URL=http://localhost:11434
# Docker Desktop (Windows/macOS): localhost does not reach a native Ollama from the
# container, use this instead:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional VRAM cap for the compose `ollama` service, in BYTES (0 = unlimited;
# 8589934592 = 8 GiB).
# OLLAMA_MAX_VRAM=0
