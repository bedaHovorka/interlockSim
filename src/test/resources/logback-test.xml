<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- Console appender for stdout (WARN level only for tests) -->
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
		</encoder>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>WARN</level>
		</filter>
	</appender>

	<!-- Console appender for stderr (ERROR levels) -->
	<appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
		<target>System.err</target>
		<encoder>
			<pattern>%msg%n</pattern>
		</encoder>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>ERROR</level>
		</filter>
	</appender>

	<!-- File appender for test runs (optional, can be disabled) -->
	<appender name="FILE" class="ch.qos.logback.core.FileAppender">
		<file>build/test-logs/interlockSim-test.log</file>
		<append>false</append>
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<!-- Suppress verbose navigation logging during tests -->
	<logger name="cz.vutbr.fit.interlockSim.context.navigation" level="WARN"/>

	<!-- Suppress verbose simulation logging during tests -->
	<logger name="cz.vutbr.fit.interlockSim.sim.Train" level="WARN"/>
	<logger name="cz.vutbr.fit.interlockSim.sim.ShuntingLoop" level="WARN"/>
	<logger name="cz.vutbr.fit.interlockSim.sim.InOutWorker" level="WARN"/>

	<!-- Suppress verbose object logging during tests -->
	<logger name="cz.vutbr.fit.interlockSim.objects" level="WARN"/>

	<!-- jDisco statistics suppressed during tests -->
	<logger name="jDisco.statistics" level="ERROR"/>

	<!-- Root logger - WARN level for tests -->
	<root level="WARN">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="STDERR"/>
		<!-- Uncomment to enable file logging for tests:
		<appender-ref ref="FILE"/>
		-->
	</root>
</configuration>
