<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for stdout (INFO and DEBUG levels) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36}.%M\(%F:%L\) - %msg%n</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- Console appender for stderr (WARN and ERROR levels) -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
    </appender>

    <!-- File appender for simulation runs -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/interlockSim.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36}.%M\(%F:%L\) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Separate logger for simulation events -->
    <logger name="cz.vutbr.fit.interlockSim.simulation" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Separate logger for jDisco reports -->
    <logger name="jDisco.statistics" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Debug logging for train simulation -->
    <logger name="cz.vutbr.fit.interlockSim.sim.Train" level="DEBUG"/>
    <logger name="cz.vutbr.fit.interlockSim.sim.ShuntingLoop" level="DEBUG"/>

    <!-- Enhanced logging for Priority 1: Switch State Logging -->
    <logger name="cz.vutbr.fit.interlockSim.objects.cells.RailSwitch" level="INFO">
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Enhanced logging for Priority 2: Block Transition Logging -->
    <logger name="cz.vutbr.fit.interlockSim.objects.tracks.SimpleTrack" level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Enhanced logging for Priority 5: Approval Decision Logging -->
    <logger name="cz.vutbr.fit.interlockSim.sim.InOutWorker" level="INFO">
        <appender-ref ref="FILE"/>
    </logger>
    <logger name="cz.vutbr.fit.interlockSim.objects.paths.AbstractPath" level="DEBUG">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
