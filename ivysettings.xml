<ivysettings>
    <!-- Default cache location: ~/.ivy2/cache -->
    <settings defaultResolver="chain-resolver"/>

    <!-- Property for Maven local repository location -->
    <property name="maven.local.repo" value="${user.home}/.m2/repository"/>

    <resolvers>
        <!-- Chain resolver: try Maven local first, then Maven Central -->
        <chain name="chain-resolver">
            <!-- Maven local repository (for jDisco) -->
            <ibiblio name="local-maven"
                     root="file://${maven.local.repo}"
                     m2compatible="true"
                     checkmodified="true"/>

            <!-- Maven Central repository (for JUnit and other dependencies) -->
            <ibiblio name="maven-central"
                     m2compatible="true"
                     root="https://repo1.maven.org/maven2/"/>
        </chain>
    </resolvers>
</ivysettings>
