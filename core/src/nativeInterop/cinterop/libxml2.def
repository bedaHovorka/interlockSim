headers = libxml/parser.h libxml/xmlschemas.h libxml/xmlerror.h libxml/tree.h
package = libxml2
compilerOpts.linux = -I/usr/include/libxml2
# Kotlin/Native's bundled ld.lld does not search system lib dirs by default.
# -L/usr/lib64: Fedora/RHEL; -L/usr/lib/x86_64-linux-gnu: Debian/Ubuntu (Docker, CI).
linkerOpts.linux = -L/usr/lib64 -L/usr/lib/x86_64-linux-gnu -lxml2
