<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- Console appender for stdout (WARN level only for tests) -->
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
		</encoder>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>WARN</level>
		</filter>
	</appender>

	<!--
		There is deliberately no console appender on System.err (Issue #1011).
		A single ERROR event used to be written to stdout AND stderr, and Gradle drains a test
		JVM's two streams with two separate forwarding threads. Concurrent forwarding is the
		suspect mechanism behind the JVM XML failures ("Could not write XML test results for
		... to file ..." with zero failed tests) — but only a probable cause here: upstream
		(gradle/gradle#33990) proves it for Kotlin test tasks, whose maintainer says regular
		JVM Test output should already be serialized, and the upstream race is unfixed. The
		single-stream setup is therefore a precaution: it removes the trigger this project
		can remove. The CONSOLE appender above already prints ERROR (its threshold is WARN),
		so the stderr copy only duplicated output. Keep console test output on stdout only.
	-->

	<!-- File appender for test runs (optional, can be disabled) -->
	<appender name="FILE" class="ch.qos.logback.core.FileAppender">
		<file>build/test-logs/interlockSim-test.log</file>
		<append>false</append>
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<!-- Suppress verbose navigation logging during tests -->
	<logger name="cz.vutbr.fit.interlockSim.context.navigation" level="WARN"/>

	<!-- Suppress verbose simulation logging during tests -->
	<logger name="cz.vutbr.fit.interlockSim.sim.Train" level="WARN"/>
	<logger name="cz.vutbr.fit.interlockSim.sim.ShuntingLoop" level="WARN"/>
	<logger name="cz.vutbr.fit.interlockSim.sim.InOutWorker" level="WARN"/>

	<!-- Suppress verbose object logging during tests -->
	<logger name="cz.vutbr.fit.interlockSim.objects" level="WARN"/>

	<!--
		PathCommandTranslator emits its skip/diagnostic messages at DEBUG. Enabling DEBUG here
		makes the lambda bodies actually evaluate during tests, so a broken string interpolation
		in a log statement fails the build instead of hiding behind a disabled log level.
		The class is only exercised by PathCommandTranslatorTest, so this adds no test noise.
	-->
	<logger name="cz.vutbr.fit.interlockSim.sim.PathCommandTranslator" level="DEBUG"/>
	<logger name="cz.vutbr.fit.interlockSim.sim.PathCommandTranslatorKt" level="DEBUG"/>

	<!--
		DefaultPathReservationService logs its reservation/rollback bookkeeping at DEBUG (the
		routine rollback line was INFO before the Issue #1025 review round demoted it). Same
		rationale as PathCommandTranslator above: with the package pinned at WARN, those lambda
		bodies never evaluate during tests, so a broken string interpolation in a rollback message
		hides behind a disabled log level. The appenders filter at WARN, so nothing extra prints.
	-->
	<logger name="cz.vutbr.fit.interlockSim.context.navigation.DefaultPathReservationService" level="DEBUG"/>

	<!--
		ReservationResultMapping.kt logs one INFO "Route GRANTED/DENIED" line per kernel outcome.
		Same rationale as above: with the root at WARN those lambda bodies never evaluate, so a
		broken interpolation would hide. The appenders filter at WARN, so nothing extra prints.
	-->
	<logger name="cz.vutbr.fit.interlockSim.sim.ReservationResultMappingKt" level="INFO"/>

	<!-- kDisco statistics suppressed during tests -->
	<logger name="kDisco.statistics" level="ERROR"/>

	<!-- Root logger - WARN level for tests -->
	<root level="WARN">
		<appender-ref ref="CONSOLE"/>
		<!-- Uncomment to enable file logging for tests:
		<appender-ref ref="FILE"/>
		-->
	</root>
</configuration>
