<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- Console appender for stdout (WARN level only for tests) -->
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
		</encoder>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>WARN</level>
		</filter>
	</appender>

	<!--
		There is deliberately no console appender on System.err (Issue #1011). This module
		needed a test config of its own at all because it ships :core's production logback.xml
		on its jvmTest runtime classpath (via the :core jvm jar) — with a config present,
		logback-test.xml shadows it instead. Without a provider SLF4J would additionally print
		its no-provider banner to stderr. Gradle drains a test JVM's two streams with two
		forwarding threads, and this setup keeps console test output on stdout only, with the
		thresholds at WARN so nothing is printed that was not printed before. See :core's
		logback-test.xml for the full precaution-vs-proven-fix commentary.
	-->

	<!-- Root logger - WARN level for tests -->
	<root level="WARN">
		<appender-ref ref="CONSOLE"/>
	</root>
</configuration>